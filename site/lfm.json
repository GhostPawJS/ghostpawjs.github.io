  "data": {
    "measured": "Measured 2026-10-24 on the maintainer's machine with Node.js 24.14.0 against the version shown: tests from node --test at the release tag, size as gzip -9 of the published dist/index.js, import time as the median of 11 cold imports.",
    "packages": [
      {
        "key": "memory",
        "file": "MEMORY.md",
        "name": "codex",
        "pkg": "@ghostpaw/codex",
        "version": "0.3.2",
        "role": "Beliefs instead of a memory file",
        "fields": [
          "claim",
          "source: explicit, observed or inferred",
          "certainty and evidence count",
          "freshness",
          "lineage of corrections"
        ],
        "deps": "0",
        "tests": "380",
        "gzip": "31.5 KB",
        "importMs": "2.5 ms",
        "page": "agentMemory",
        "docs": "demoCodex",
        "docsLabel": "codex live demo",
        "gives": "MEMORY.md stops being a junk drawer: every belief carries its source and certainty, stale ones are flagged when read, and a wrong fact gets corrected with its lineage kept.",
        "gh": "ghCodex"
      },
      {
        "key": "tasks",
        "file": "TODO.md",
        "name": "questlog",
        "pkg": "@ghostpaw/questlog",
        "version": "0.6.2",
        "role": "Quests instead of a to-do list",
        "fields": [
          "title and objective",
          "dueAt or a scheduled window",
          "unlocks that block other quests",
          "outcome text on finish",
          "repeat rule (RRULE)"
        ],
        "deps": "0",
        "tests": "352",
        "gzip": "42.1 KB",
        "importMs": "3.7 ms",
        "page": "agentTasks",
        "docs": "demoQuestlog",
        "docsLabel": "questlog live demo",
        "gives": "An agent that said it was done has to write down what came of it, and a blocked quest stays blocked until the one before it succeeds.",
        "gh": "ghQuestlog"
      },
      {
        "key": "people",
        "file": "USER.md",
        "name": "affinity",
        "pkg": "@ghostpaw/affinity",
        "version": "0.3.0",
        "role": "Contacts instead of a user note",
        "fields": [
          "contact and identities (email, phone, account)",
          "social link: rank, trust, cadence",
          "ties such as works_at",
          "journal entries as evidence",
          "date anchors such as birthdays"
        ],
        "deps": "0",
        "tests": "459",
        "gzip": "56.1 KB",
        "importMs": "4.8 ms",
        "page": "agentContacts",
        "docs": "demoAffinity",
        "docsLabel": "affinity live demo",
        "gives": "The people your agent deals with, with their accounts, a journal of what happened, the promises made and the dates that matter, plus a radar of who is drifting out of touch.",
        "gh": "ghAffinity"
      },
      {
        "key": "identity",
        "file": "SOUL.md",
        "name": "souls",
        "pkg": "@ghostpaw/souls",
        "version": "0.3.0",
        "role": "An identity that changes with evidence",
        "fields": [
          "essence",
          "traits with evidence",
          "level-up consolidation",
          "full rollback"
        ],
        "deps": "0",
        "tests": "532",
        "gzip": "31.4 KB",
        "importMs": "2.8 ms",
        "page": "agentIdentity",
        "docs": "demoSouls",
        "docsLabel": "souls live demo",
        "gives": "Character that moves only on evidence: refinements wait for level-up, and any of them can be rolled back.",
        "gh": "ghSouls"
      },
      {
        "key": "skills",
        "file": "skills/",
        "name": "grimoire",
        "pkg": "@ghostpaw/grimoire",
        "version": "0.3.0",
        "role": "Procedures that get better and keep their history",
        "fields": [
          "spell: a SKILL.md file",
          "seal: a git commit per verified improvement",
          "tier from seal count",
          "notes awaiting distillation",
          "catalogue health snapshot"
        ],
        "deps": "0",
        "tests": "872",
        "gzip": "46.4 KB",
        "importMs": "7.6 ms",
        "page": "agentSkills",
        "docs": "demoGrimoire",
        "docsLabel": "grimoire live demo",
        "gives": "Procedures stay SKILL.md files, each verified improvement is a git commit, and a health check names stale, dormant and oversized skills.",
        "gh": "ghGrimoire"
      },
      {
        "key": "inbox",
        "file": "inbox/",
        "name": "email",
        "pkg": "@ghostpaw/email",
        "version": "0.4.1",
        "role": "A mailbox the agent can search offline",
        "fields": [
          "account with IMAP and SMTP config",
          "folder with sync state",
          "message headers, flags, labels",
          "body and attachments",
          "thread tree"
        ],
        "deps": "0",
        "tests": "563",
        "gzip": "47.8 KB",
        "importMs": "10.4 ms",
        "page": "agentEmail",
        "docs": "docsEmail",
        "docsLabel": "email docs",
        "gives": "Your agent can read and search the mailbox. Whether it can also send is a separate tool, and you decide.",
        "gh": "ghEmail"
      },
      {
        "key": "chat",
        "file": "chat log",
        "name": "telegram",
        "pkg": "@ghostpaw/telegram",
        "version": "0.6.2",
        "role": "Every Telegram update kept before your handler runs",
        "fields": [
          "message mirror with edit history",
          "reply chains",
          "FTS5 search with diacritic folding",
          "file bytes as BLOBs, stored once per SHA-256 hash",
          "plan-first agent tools"
        ],
        "deps": "0",
        "tests": "887",
        "gzip": "34.2 KB",
        "importMs": "8.9 ms",
        "page": "agentTelegram",
        "docs": "docsTelegram",
        "docsLabel": "telegram docs",
        "gives": "Every update lands in SQLite before your handler runs, edits keep the old text, and the agent's tools only plan until you switch execution on.",
        "gh": "ghTelegram"
      }
    ],
    "run": [
      {
        "lib": "telegram",
        "what": "Lena posts “Invoice 4471 is paid” in the Renewal desk group, and telegram has the row before your handler sees it.",
        "file": "telegram.db",
        "lands": "Lena's message, edit kept"
      },
      {
        "lib": "affinity",
        "what": "Your handler looks her up by Telegram account and adds the exchange to her journal.",
        "file": "affinity.db",
        "lands": "journal entry for Lena"
      },
      {
        "lib": "codex",
        "what": "The agent writes “invoice 4471 is paid” as an explicit belief. Yesterday's belief said it was overdue. That one is superseded, not deleted, so you can still see what the agent thought before and why it changed.",
        "file": "codex.db",
        "lands": "belief superseded, lineage kept"
      },
      {
        "lib": "questlog",
        "what": "The quest “Chase invoice 4471” closes only with a written outcome: paid, confirmed by Lena in the group.",
        "file": "questlog.db",
        "lands": "quest done, outcome written"
      },
      {
        "lib": "email",
        "what": "It finds the invoice thread in the cached inbox with mail_search and labels it paid with mail_organize. A reply to the vendor would need mail_compose, which this agent was never given.",
        "file": "email.db",
        "lands": "thread labelled paid"
      },
      {
        "lib": "grimoire",
        "what": "It followed the steps in a SKILL.md for closing a paid invoice. Last time the receipt went to the wrong folder, and that note is still attached. When a better version proves itself, it is sealed as a git commit you can diff and roll back.",
        "file": "grimoire/",
        "lands": "note on a SKILL.md, then a seal"
      },
      {
        "lib": "souls",
        "what": "Weeks of runs like this one pile up evidence for a trait: confirm payment with a person before closing a quest. The essence only changes at level-up, and you can roll the change back.",
        "file": "souls.db",
        "lands": "evidence for one trait"
      }
    ]
  },

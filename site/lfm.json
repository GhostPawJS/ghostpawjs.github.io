      {
        "key": "memory",
        "file": "MEMORY.md",
        "name": "codex",
        "pkg": "@ghostpaw/codex",
        "version": "0.3.0",
        "role": "Beliefs instead of a memory file",
        "line": "Every remembered line becomes a belief with a source, a certainty and a history. Flags for stale, fading and low-trust beliefs are computed each time you read, so the junk drawer shows you what to prune. Since 0.3.0 it also ships an MCP server and a ghostpaw-codex command line tool.",
        "fields": [
          "claim",

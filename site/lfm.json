    "agentContacts": "https://affinity.ghostpaw.dev/",
    "agentIdentity": "https://souls.ghostpaw.dev/",
    "agentSkills": "https://grimoire.ghostpaw.dev/",
    "agentEmail": "https://email.ghostpaw.dev/",
    "agentTelegram": "https://telegram.ghostpaw.dev/",
    "docsEmail": "https://email.ghostpaw.dev/docs/",

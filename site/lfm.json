{
  "schemaVersion": 1,
  "url": "https://ghostpaw.dev/",
  "language": "en",
  "title": "GhostPaw: Node.js libraries for the MEMORY.md and task files your agent keeps",
  "description": "Seven MIT-licensed Node.js 24 libraries for agents that run on their own: memory, tasks, contacts, identity, skills, email and Telegram, each kept as SQLite records you can read, correct and delete. None has a runtime dependency.",
  "socialImage": {
    "src": "assets/images/share.png",
    "alt": "A wolf head drawn in cyan light on black, beside the headline: Your agent keeps its state in markdown files."
  },
  "urls": {
    "agentMemory": "https://codex.ghostpaw.dev/",
    "agentTasks": "https://questlog.ghostpaw.dev/",
    "githubOrg": "https://github.com/GhostPawJS",

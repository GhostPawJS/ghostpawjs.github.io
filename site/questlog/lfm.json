    "agentMemory": "https://ghostpaw.anonyfox.com/agent-memory/",
    "github": "https://github.com/GhostPawJS/questlog",
    "readme": "https://github.com/GhostPawJS/questlog#readme",
    "npm": "https://www.npmjs.com/package/@ghostpaw/questlog",
    "demo": "https://ghostpaw.anonyfox.com/questlog/",
    "impressum": "https://lab.anonyfox.com/impressum/",

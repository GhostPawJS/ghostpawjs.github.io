{
  "schemaVersion": 1,
  "url": "https://ghostpaw.anonyfox.com/agent-tasks/",
  "language": "en",
  "title": "questlog: an agent task list that will not mark work done without an outcome",
  "description": "@ghostpaw/questlog keeps agent tasks as quests in SQLite. Finishing one needs a written outcome, blocked quests stay off the available list until their prerequisite succeeds, and due dates turn overdue on their own. Node.js 24, zero dependencies, MIT.",
